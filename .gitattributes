# Ensure shell and extensionless CLI scripts always have LF line endings
*.sh text eol=lf
evals/bin/* text eol=lf
scripts/git-hooks/* text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.py text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.gif binary
