#!/usr/bin/env bash
# Tunes one skill's description against its query set: score it with
# bin/triggering, revise it against the TRAIN failures in a skill-free agent
# session, repeat, and select the iteration with the best VALIDATION pass
# rate (then train, then the shortest description). The holdout split is
# never shown to the reviser and never drives selection: it is scored once,
# for the selected description, after the loop.
#
# Every scoring round and every revision is a live agent session. Run
# --dry-run first: it prints the budget.
set -uo pipefail
export LC_ALL=C
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
. "$here/../lib/common.sh"
. "$here/../lib/home-env.sh"
. "$here/../lib/stream-text.sh"

usage() {
  cat <<'EOF'
Usage: evals/bin/optimize-description --pack PACK --skill NAME [options]

  --harness NAME        claude-code (default), codex, or antigravity
  --runs N              runs per query per round (default 3)
  --max-iterations K    scoring rounds, at most (default 5)
  --jobs N              runs in parallel within a round (default 3)
  --timeout SECONDS     per-session timeout (default 120)
  --max-turns N         turn cap per scoring session (default 6)
  --model NAME          model passed to the harness
  --out DIR             workspace (default evals/workspaces/<stamp>-<pack>-<skill>-<harness>-optimize)
  --apply               write the selected description into the skill's SKILL.md
  --allow-unverified    run an adapter marked runnable=no
  --dry-run             print and price the plan; call nothing

Writes iteration-<i>/{description.txt,triggering/,reviser-prompt.txt,candidate.txt},
holdout/ (when the query set has one), and optimization.json.

Exit: 0 an iteration was selected · 2 bad arguments, a round that could not
      run, or no iteration with a validation rate · 3 the harness CLI is missing
EOF
}

pack="" skill="" harness=claude-code runs=3 max_iter=5 jobs=3 timeout_s=120 maxturns=6
model="" out="" apply=0 allow_unverified=0 dry_run=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --pack) pack="${2:-}"; shift 2 ;;
    --skill) skill="${2:-}"; shift 2 ;;
    --harness) harness="${2:-}"; shift 2 ;;
    --runs) runs="${2:-}"; shift 2 ;;
    --max-iterations) max_iter="${2:-}"; shift 2 ;;
    --jobs) jobs="${2:-}"; shift 2 ;;
    --timeout) timeout_s="${2:-}"; shift 2 ;;
    --max-turns) maxturns="${2:-}"; shift 2 ;;
    --model) model="${2:-}"; shift 2 ;;
    --out) out="${2:-}"; shift 2 ;;
    --apply) apply=1; shift ;;
    --allow-unverified) allow_unverified=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; log "error: unknown option: $1"; exit 2 ;;
  esac
done
fail2() { log "error: $*"; exit 2; }
require_tool git python3 jq || exit 3
[ -n "$pack" ] && [ -n "$skill" ] || { usage >&2; fail2 "--pack and --skill are required"; }
for n in runs max_iter jobs timeout_s maxturns; do
  case "${!n}" in ''|0*|*[!0-9]*) fail2 "--${n//_/-} must be a positive integer" ;; esac
done

repo="$(repo_root)"
qfile="$repo/evals/$pack/$skill/queries.json"
[ -f "$qfile" ] || fail2 "no queries at evals/$pack/$skill/queries.json"
rel="$(skill_rel_dir "$repo" "$pack" "$skill")" || fail2 "no skill at skills/$pack/$skill/ or skills/in-progress/$skill/"
skill_md="$repo/$rel/SKILL.md"
meta="$(evalkit skill-meta "$skill_md")" || exit 2
[ "$(jq -r .manual_only <<< "$meta")" = false ] || fail2 "$skill is manual-only: there is no description routing to tune"
all_q="$(evalkit queries "$qfile" 0)" || exit 2
n_loop="$(jq '[.[] | select(.split == "train" or .split == "validation")] | length' <<< "$all_q")"
n_hold="$(jq '[.[] | select(.split == "holdout")] | length' <<< "$all_q")"

common=(--pack "$pack" --skill "$skill" --harness "$harness" --runs "$runs" --jobs "$jobs"
        --timeout "$timeout_s" --max-turns "$maxturns")
[ -n "$model" ] && common+=(--model "$model")
[ "$allow_unverified" -eq 1 ] && common+=(--allow-unverified)

load_adapter "$harness" || exit 2
scoring=$((max_iter * n_loop * runs))
total=$((scoring + (max_iter - 1) + n_hold * runs))
log "plan: optimize the $pack/$skill description on $harness"
[ "$runnable" = yes ] || log "  adapter: runnable=no ($runnable_reason)"
log "  at most $max_iter round(s) x $n_loop train+validation queries x $runs run(s) = $scoring scoring session(s)"
log "  + up to $((max_iter - 1)) reviser session(s) + $((n_hold * runs)) holdout session(s) for the winner"
log "  at most $total agent session(s); the loop stops early once train has no failure"
if [ -n "${EVALS_COST_PER_SESSION:-}" ]; then
  log "  estimated cost: at most $(awk -v n="$total" -v c="$EVALS_COST_PER_SESSION" 'BEGIN { printf "%.2f", n * c }')"
fi
[ "$apply" -eq 1 ] && log "  --apply: the selected description is written to $rel/SKILL.md"
if [ "$dry_run" -eq 1 ]; then
  log "dry run: nothing was called"
  exit 0
fi

adapter_gate "$harness" "$allow_unverified" || exit $?
require_tool timeout || exit 3

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
ws="${out:-${EVALS_WORKSPACE:-$repo/evals/workspaces}/$stamp-$pack-$skill-$harness-optimize}"
[ -e "$ws" ] && fail2 "workspace already exists: $ws"
mkdir -p "$ws" || exit 2
ws="$(cd "$ws" && pwd -P)"
run_base="$(mktemp -d "${TMPDIR:-/tmp}/augments-evals-$(basename "$ws").XXXXXX")" || exit 2
cleanup() {
  [ -d "$run_base" ] && find "$run_base" -type d -name home -prune -exec rm -rf {} + 2>/dev/null
  rm -rf "$run_base"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

body="$(awk 'NR == 1 && $0 == "---" { fm = 1; next } fm && $0 == "---" { fm = 0; next } !fm { print }' "$skill_md")"
current="$(jq -r .description <<< "$meta")"

# The reviser sees the current description, the skill body, and the TRAIN
# failures only: never validation (it selects) and never holdout (it reports).
reviser_prompt() { # $1 query-results.json
  local fails
  fails="$(jq -r '.[] | select(.split == "train" and .verdict == "fail")
    | if .should_trigger then "- should load the skill, but did not: \(.query)"
      else "- should NOT load the skill, but did: \(.query)" end' "$1")"
  cat <<EOF
You are revising the description of one agent skill, \`$skill\`. An agent reads
only this description when it decides whether to load the skill, so the
description must make it load on the requests the skill serves and stay quiet
on requests that belong elsewhere.

Current description:
$current

The skill's instructions (its SKILL.md body):
$body

Requests the current description routed wrongly:
$fails

Write one improved description. Say what the skill is for and when to use it,
so it covers requests like the ones it missed and excludes the ones it should
not take; generalize from the requests rather than copying them.
Rules: a single line, at most 1024 characters, none of these characters: < > " \\

Write the description and nothing else to the file candidate-description.txt in
the current directory. If you cannot write files, reply with the description alone.
EOF
}

run_reviser() { # $1 iteration dir; writes $1/candidate.txt
  local it="$1" base="$run_base/reviser-$(basename "$1")" rc=0
  mkdir -p "$base" || return 1
  reviser_prompt "$it/triggering/query-results.json" > "$it/reviser-prompt.txt"
  seed_workdir "$base/work" "" || return 1
  timeout_s="$timeout_s" lab_session "$base" "" behavioral "$base/work" "$it/reviser-prompt.txt" \
    "$it/reviser-stream.ndjson" "$it/reviser-stderr.log" || rc=$?
  [ -z "$setup_failed" ] || { log "reviser: $setup_failed"; return 1; }
  if [ -f "$base/work/candidate-description.txt" ]; then
    cp "$base/work/candidate-description.txt" "$it/candidate.txt"
  elif [ "$rc" -eq 0 ] && [ -s "$it/reviser-stream.ndjson" ]; then
    lab_extract_stream_text "$it/reviser-stream.ndjson" "$harness" > "$it/candidate.txt" 2>/dev/null || return 1
  else
    return 1
  fi
  rm -rf "$base"
}

iterations='[]'
stop_reason=""
i=1
while :; do
  it="$ws/iteration-$i"
  mkdir -p "$it"
  printf '%s\n' "$current" > "$it/description.txt"
  log "iteration $i: scoring"
  "$here/triggering" "${common[@]}" --splits train,validation --description-file "$it/description.txt" \
    --out "$it/triggering" > "$it/triggering.log" 2>&1
  rc=$?
  [ "$rc" -le 1 ] && [ -f "$it/triggering/triggering.json" ] \
    || fail2 "iteration $i could not be scored (see $it/triggering.log)"
  iterations="$(jq --argjson i "$i" --arg d "$current" --slurpfile t "$it/triggering/triggering.json" \
    '. + [{iteration: $i, description: $d, train: $t[0].splits.train, validation: $t[0].splits.validation}]' \
    <<< "$iterations")"
  read -r t_scored t_fail < <(jq -r '.splits.train | "\(.queries - .inconclusive) \(.queries - .inconclusive - .passed)"' \
    "$it/triggering/triggering.json")
  if [ "$t_scored" -eq 0 ]; then stop_reason="train scored nothing (every query inconclusive)"; break; fi
  if [ "$t_fail" -eq 0 ]; then stop_reason="train has no failure"; break; fi
  if [ "$i" -ge "$max_iter" ]; then stop_reason="reached --max-iterations $max_iter"; break; fi

  log "iteration $i: revising against $t_fail train failure(s)"
  if ! run_reviser "$it"; then stop_reason="the reviser returned no candidate"; break; fi
  if ! cand="$(evalkit check-candidate "$it/candidate.txt" 2>"$it/candidate-rejected.txt")"; then
    stop_reason="candidate rejected: $(sed 's/^rejected: //' "$it/candidate-rejected.txt")"; break
  fi
  rm -f "$it/candidate-rejected.txt"
  current="$cand"
  i=$((i + 1))
done

best="$(jq 'map(select(.validation.pass_rate != null)
    | . + {v: .validation.pass_rate, t: (.train.pass_rate // -1), n: (.description | length)})
  | sort_by(-.v, -.t, .n, .iteration) | .[0].iteration // null' <<< "$iterations")"
outcome=indeterminate best_desc="" holdout=null applied=false
if [ "$best" != null ]; then
  outcome=selected
  best_desc="$(jq -r --argjson b "$best" '.[] | select(.iteration == $b) | .description' <<< "$iterations")"
  if [ "$n_hold" -gt 0 ]; then
    log "holdout: scoring the selected description once"
    "$here/triggering" "${common[@]}" --splits holdout --description-file "$ws/iteration-$best/description.txt" \
      --out "$ws/holdout" > "$ws/holdout.log" 2>&1
    if [ -f "$ws/holdout/triggering.json" ]; then
      holdout="$(jq -c '.splits.holdout' "$ws/holdout/triggering.json")"
    else
      log "holdout: could not be scored (see $ws/holdout.log)"
    fi
  fi
  if [ "$apply" -eq 1 ]; then
    if [ "$best_desc" = "$(jq -r .description <<< "$meta")" ]; then
      log "apply: the selected description is the committed one; nothing to write"
    else
      printf '%s\n' "$best_desc" > "$ws/best-description.txt"
      evalkit set-description "$skill_md" "$ws/best-description.txt" || fail2 "--apply could not write $rel/SKILL.md"
      applied=true
    fi
  fi
else
  stop_reason="$stop_reason; no iteration has a validation rate, so none is selected"
fi

jq -n --arg pack "$pack" --arg skill "$skill" --arg harness "$harness" --argjson runs "$runs" \
  --argjson max "$max_iter" --argjson iterations "$iterations" --arg outcome "$outcome" \
  --argjson best "$best" --arg best_desc "$best_desc" --argjson holdout "$holdout" \
  --arg stop "$stop_reason" --argjson applied "$applied" --arg at "$(utc_now)" \
  '{schema_version: 1, pack: $pack, skill: $skill, harness: $harness, runs: $runs, max_iterations: $max,
    measured_at: $at, iterations: $iterations, outcome: $outcome, best_iteration: $best,
    best_description: (if $best == null then null else $best_desc end), holdout: $holdout,
    stop_reason: $stop, applied: $applied}' > "$ws/optimization.json" || fail2 "cannot write $ws/optimization.json"

log "stop: $stop_reason"
log "wrote: $ws/optimization.json"
[ "$outcome" = selected ] || { log "outcome: indeterminate; nothing selected or applied"; exit 2; }
log "best: iteration $best: $best_desc"
[ "$applied" = true ] && log "applied: $rel/SKILL.md (commit it, then record a fresh evals/bin/triggering run)"
printf '%s\n' "$ws/optimization.json"
exit 0
