#!/usr/bin/env bash
# Records a finished eval into evals/results/<pack>/<skill>.json and keeps
# the README scoreboard in sync.
set -euo pipefail
export LC_ALL=C
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
. "$here/../lib/common.sh"

usage() {
  cat <<'EOF'
Usage:
  evals/bin/report WORKSPACE|RECORD.json [--date YYYY-MM-DD]
      Validate the workspace's benchmark.json or triggering.json, merge its
      compact summary into evals/results/<pack>/<skill>.json (replacing any
      previous skill tree in place), and refresh the README scoreboard.
  evals/bin/report --scoreboard [--check]
      Rewrite the README table between the eval-scoreboard markers from
      evals/results/*/*.json; --check exits 1 when it has drifted.
EOF
}

repo="$(repo_root)"
results="$repo/evals/results"
readme="$repo/README.md"

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") usage >&2; exit 2 ;;
  --scoreboard)
    shift
    case "${1:-}" in
      "") evalkit scoreboard "$readme" "$results" ;;
      --check) evalkit scoreboard "$readme" "$results" --check ;;
      *) usage >&2; exit 2 ;;
    esac
    exit $? ;;
esac

src="$1"; shift
date=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --date) date="${2:-}"; shift 2 ;;
    *) usage >&2; die "unknown option: $1" ;;
  esac
done

if [ -d "$src" ]; then
  found=()
  for f in benchmark.json triggering.json; do
    if [ -f "$src/$f" ]; then found+=("$src/$f"); fi
  done
  [ "${#found[@]}" -eq 1 ] || die "$src must hold exactly one of benchmark.json or triggering.json"
  src="${found[0]}"
fi
[ -f "$src" ] || die "no record at $src"
target="$(evalkit record "$src" "$results" "$date")" || exit 1
log "recorded: ${target#"$repo"/}"
evalkit scoreboard "$readme" "$results" >&2
printf '%s\n' "$target"
