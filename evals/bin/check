#!/usr/bin/env bash
# Offline eval harness check (no live LLM calls).
# Dispatches syntax checks by shebang/extension, runs the offline fake-cli
# suites with tripwire shims ahead of every real agent CLI on PATH, and checks
# the README scoreboard against evals/results/.
set -euo pipefail
export LC_ALL=C
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

errors=0
check_script() {
  local f="$1"
  local first_line=""
  IFS= read -r first_line < "$f" || true
  case "$first_line:$f" in
    *python*:*|*:*.py)
      if command -v python3 >/dev/null 2>&1; then
        python3 -m py_compile "$f" || { echo "FAIL: python syntax error in $f" >&2; errors=$((errors + 1)); }
      fi
      ;;
    *bash*:*|*sh:*|*:*.sh|*:*.bash)
      bash -n "$f" || { echo "FAIL: bash syntax error in $f" >&2; errors=$((errors + 1)); }
      ;;
    *)
      echo "WARN: skipping unknown script type: $f" >&2
      ;;
  esac
}

for f in scripts/*.sh evals/bin/* evals/lib/*.sh evals/lib/*.py evals/harnesses/*.sh \
         evals/lib/tests/*.sh evals/lib/tests/*.bash evals/lib/tests/fake-cli/*.sh \
         evals/lib/tests/tripwire/* evals/lib/tests/fixtures/harnesses/*.sh; do
  [ -f "$f" ] || continue
  check_script "$f"
done
# Byte-compiling leaves caches behind; keep the tree clean.
find evals -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true

if [ -d evals/lib/tests ]; then
  # Every real agent CLI resolves to a tripwire that logs and fails, so no
  # suite can reach a live model even by mistake.
  trip_dir="$(mktemp -d)"
  trap 'rm -rf "$trip_dir"' EXIT
  cp evals/lib/tests/tripwire/* "$trip_dir/"
  chmod +x "$trip_dir"/*
  export TRIPWIRE_LOG="$trip_dir/tripwire.log"
  : > "$TRIPWIRE_LOG"
  for t in evals/lib/tests/*.sh; do
    [ -f "$t" ] || continue
    PATH="$trip_dir:$PATH" bash "$t" || { echo "FAIL: eval test failed: $t" >&2; errors=$((errors + 1)); }
  done
  if [ -s "$TRIPWIRE_LOG" ]; then
    echo "FAIL: a suite invoked a real agent CLI:" >&2
    cat "$TRIPWIRE_LOG" >&2
    errors=$((errors + 1))
  fi
fi

if command -v python3 >/dev/null 2>&1; then
  python3 -I evals/lib/evalkit.py scoreboard README.md evals/results --check \
    || { echo "FAIL: README scoreboard drifted from evals/results (run evals/bin/report --scoreboard)" >&2; errors=$((errors + 1)); }
fi

if [ "$errors" -gt 0 ]; then
  exit 1
fi

echo "ok: evals/bin/check passed (offline syntax, fake-cli suites under the tripwire, scoreboard)."
