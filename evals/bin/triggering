#!/usr/bin/env bash
# Scores a skill's DESCRIPTION, not a run: does it load on the requests it
# serves and stay quiet on the ones it does not?
#
# Routing is non-deterministic, so the unit of evidence is a query repeated N
# times and reduced to a trigger rate over valid runs. A should-trigger query
# passes when its rate is above the threshold; a should-not query passes when
# it is below. A query with no valid run is inconclusive.
#
# Pass --with-skills NAME[,NAME...] (or --with-skills all) to install neighbor
# skills beside the skill under test for a fast, 1-turn pack-routing check:
# any query where a neighbor fires at or above the threshold fails.
#
# Every query is a live agent session. Run --dry-run first: it prints the count.
set -uo pipefail
export LC_ALL=C
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
. "$here/../lib/common.sh"
. "$here/../lib/home-env.sh"
. "$here/../lib/stream-text.sh"

usage() {
  cat <<'EOF'
Usage: evals/bin/triggering --pack PACK --skill NAME [options]
       evals/bin/triggering --pack PACK --skill-dir DIR --queries FILE [options]

  --harness NAME          claude-code (default), codex, or antigravity
  --runs N                runs per query (default 3)
  --splits LIST           filter queries by split (default: all queries in queries.json)
  --with-skills LIST      install competing neighbor skill(s) beside the skill under test
                          for a 1-turn routing check (comma-separated names, or "all" for
                          every other promoted skill in --pack; not recordable)
  --threshold X           trigger-rate threshold, 0 < X < 1 (default 0.5)
  --jobs N                runs in parallel (default 3)
  --timeout SECONDS       per-session timeout (default 120)
  --max-turns N           turn cap per session (default 6)
  --description-file F    score this candidate description instead of the committed one
                          (its record has a null skill_tree and cannot be recorded)
  --queries FILE          score these queries instead of evals/<pack>/<skill>/queries.json;
                          fixtures resolve under files/ next to FILE
  --skill-dir DIR         score the skill in DIR, named by its SKILL.md name, instead of
                          --skill (needs --queries; not recordable)
  --model NAME            model passed to the harness
  --out DIR               workspace (default evals/workspaces/<stamp>-<pack>-<skill>-<harness>-triggering)
  --json                  print triggering.json instead of its path
  --allow-unverified      run an adapter marked runnable=no
  --dry-run               print and price the plan; call nothing

Exit: 0 every query passed · 1 a query failed or was inconclusive
      2 bad arguments or an unrunnable harness · 3 the harness CLI is missing
EOF
}

pack="" skill="" harness=claude-code runs=3 splits="" with_csv="" threshold=0.5 jobs=3 timeout_s=120 maxturns=6
desc_file="" model="" out="" print_json=0 allow_unverified=0 dry_run=0 qfile_flag="" skill_dir=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --pack) pack="${2:-}"; shift 2 ;;
    --skill) skill="${2:-}"; shift 2 ;;
    --harness) harness="${2:-}"; shift 2 ;;
    --runs) runs="${2:-}"; shift 2 ;;
    --splits) splits="${2:-}"; shift 2 ;;
    --with-skills) with_csv="${2:-}"; shift 2 ;;
    --threshold) threshold="${2:-}"; shift 2 ;;
    --jobs) jobs="${2:-}"; shift 2 ;;
    --timeout) timeout_s="${2:-}"; shift 2 ;;
    --max-turns) maxturns="${2:-}"; shift 2 ;;
    --description-file) desc_file="${2:-}"; shift 2 ;;
    --queries) qfile_flag="${2:-}"; shift 2 ;;
    --skill-dir) skill_dir="${2:-}"; shift 2 ;;
    --model) model="${2:-}"; shift 2 ;;
    --out) out="${2:-}"; shift 2 ;;
    --json) print_json=1; shift ;;
    --allow-unverified) allow_unverified=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; log "error: unknown option: $1"; exit 2 ;;
  esac
done
fail2() { log "error: $*"; exit 2; }
require_tool git python3 jq || exit 3
[ -n "$pack" ] || { usage >&2; fail2 "--pack is required"; }
if [ -n "$skill_dir" ]; then
  [ -z "$skill" ] || fail2 "--skill and --skill-dir are exclusive"
  [ -n "$qfile_flag" ] || fail2 "--skill-dir needs --queries"
  [ -f "$skill_dir/SKILL.md" ] || fail2 "no SKILL.md in $skill_dir"
  skill_dir="$(cd "$skill_dir" && pwd -P)"
else
  [ -n "$skill" ] || { usage >&2; fail2 "--skill or --skill-dir is required"; }
fi
for n in runs jobs timeout_s maxturns; do
  case "${!n}" in ''|0*|*[!0-9]*) fail2 "--${n%_s} must be a positive integer" ;; esac
done
awk -v t="$threshold" 'BEGIN { exit !(t ~ /^0?\.[0-9]+$/ && t > 0 && t < 1) }' || fail2 "--threshold must be between 0 and 1"
threshold="$(awk -v t="$threshold" 'BEGIN { printf "%g", t }')"

repo="$(repo_root)"
if [ -n "$skill_dir" ]; then
  src="$skill_dir"
  meta="$(evalkit skill-meta "$src/SKILL.md")" || exit 2
  skill="$(jq -r '.name // ""' <<< "$meta")"
  case "$skill" in ''|-*|*-|*--*|*[!a-z0-9-]*) fail2 "$skill_dir: name '$skill' is not a valid skill name" ;; esac
  [ "${#skill}" -le 64 ] || fail2 "$skill_dir: name '$skill' is longer than 64 characters"
else
  rel="$(skill_rel_dir "$repo" "$pack" "$skill")" || fail2 "no skill at skills/$pack/$skill/ or skills/in-progress/$skill/"
  src="$repo/$rel"
  meta="$(evalkit skill-meta "$src/SKILL.md")" || exit 2
fi

with_skills=()
with_rels=()
if [ -n "$with_csv" ]; then
  if [ "$with_csv" = all ]; then
    for d in "$repo/skills/$pack"/*/; do
      [ -f "$d/SKILL.md" ] || continue
      pn="$(basename "$d")"
      [ "$pn" = "$skill" ] && continue
      with_skills+=("$pn")
      with_rels+=("skills/$pack/$pn")
    done
    [ "${#with_skills[@]}" -gt 0 ] || fail2 "--with-skills all found no other promoted skills in skills/$pack/"
  else
    IFS=, read -r -a raw_with <<< "$with_csv"
    seen_w=" "
    for pn in "${raw_with[@]}"; do
      [ -n "$pn" ] || fail2 "empty skill name in --with-skills"
      [ "$pn" != "$skill" ] || fail2 "--with-skills cannot name the skill under test ($skill)"
      case "$seen_w" in *" $pn "*) fail2 "--with-skills listed $pn twice" ;; esac
      seen_w="$seen_w$pn "
      prel="$(skill_rel_dir "$repo" "$pack" "$pn")" || fail2 "--with-skills: no skill at skills/$pack/$pn/ or skills/in-progress/$pn/"
      with_skills+=("$pn")
      with_rels+=("$prel")
    done
  fi
fi
with_json='[]'
if [ "${#with_skills[@]}" -gt 0 ]; then
  with_json="$(printf '%s\n' "${with_skills[@]}" | jq -R . | jq -s .)"
fi

qfile="${qfile_flag:-$repo/evals/$pack/$skill/queries.json}"
[ -f "$qfile" ] || fail2 "no queries at ${qfile_flag:-evals/$pack/$skill/queries.json}"
qfile="$(cd "$(dirname "$qfile")" && pwd -P)/$(basename "$qfile")"
files_dir="$(dirname "$qfile")/files"
manual="$(jq -r 'if .manual_only then 1 else 0 end' <<< "$meta")"
queries="$(evalkit queries "$qfile" "$manual" "$splits")" || exit 2
[ "$(jq length <<< "$queries")" -gt 0 ] || fail2 "no queries in the selected splits"
fixture="$(jq -r '.fixture // ""' "$qfile")"
if [ -n "$fixture" ]; then
  case "$fixture" in /*|*..*) fail2 "queries.json fixture must be a directory name under files/" ;; esac
  [ -d "$files_dir/$fixture" ] || fail2 "fixture directory not found: files/$fixture"
fi
if [ -n "$desc_file" ]; then
  candidate="$(evalkit check-candidate "$desc_file")" || fail2 "--description-file was rejected"
fi

load_adapter "$harness" || exit 2
nq="$(jq length <<< "$queries")"
sessions=$((nq * runs))
log "plan: triggering $pack/$skill on $harness (manual_only=$([ "$manual" = 1 ] && echo true || echo false)), $runs run(s) per query, threshold $threshold"
[ "${#with_skills[@]}" -gt 0 ] && log "  with neighbor skills: ${with_skills[*]} (routing check; not recordable)"
[ "$runnable" = yes ] || log "  adapter: runnable=no ($runnable_reason)"
[ -n "$desc_file" ] && log "  scoring a candidate description from $desc_file (not recordable)"
[ -n "$skill_dir" ] && log "  scoring the skill in $skill_dir on $qfile (not recordable)"
jq -r 'group_by(.split)[] | "  \(.[0].split): \(length) quer\(if length == 1 then "y" else "ies" end)"' <<< "$queries" >&2
log "  $nq quer$([ "$nq" -eq 1 ] && echo y || echo ies) x $runs run(s) = $sessions agent session(s), $jobs at a time"
log "  worst-case wall time: $(( (sessions + jobs - 1) / jobs * timeout_s / 60 )) min at --timeout $timeout_s"
if [ -n "${EVALS_COST_PER_SESSION:-}" ]; then
  log "  estimated cost: $(awk -v n="$sessions" -v c="$EVALS_COST_PER_SESSION" 'BEGIN { printf "%.2f", n * c }')"
fi
if [ "$dry_run" -eq 1 ]; then
  log "dry run: nothing was called"
  exit 0
fi

adapter_gate "$harness" "$allow_unverified" || exit $?
require_tool timeout || exit 3
harness_version="$(adapter_version 2>/dev/null || true)"

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
ws="${out:-${EVALS_WORKSPACE:-$repo/evals/workspaces}/$stamp-$pack-$skill-$harness-triggering}"
[ -e "$ws" ] && fail2 "workspace already exists: $ws"
mkdir -p "$ws" || exit 2
ws="$(cd "$ws" && pwd -P)"
run_base="$(mktemp -d "${TMPDIR:-/tmp}/augments-evals-$(basename "$ws").XXXXXX")" || exit 2
active_pids=()
done_dir=""
cleanup() {
  trap - INT TERM
  local entry pid slot_id
  for entry in "${active_pids[@]+"${active_pids[@]}"}"; do
    pid="${entry%%:*}"
    slot_id="${entry#*:}"
    if [ -z "$done_dir" ] || [ ! -f "$done_dir/$slot_id" ]; then
      stop_tree "$pid"
    fi
  done
  for entry in "${active_pids[@]+"${active_pids[@]}"}"; do
    wait "${entry%%:*}" 2>/dev/null || true
  done
  if [ -d "${run_base:-}" ]; then
    find "$run_base" -type d -name home -prune -exec rm -rf {} + 2>/dev/null || true
    [ -n "$done_dir" ] && rm -rf "$done_dir" 2>/dev/null || true
    rm -rf "$run_base"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# The bundle: the committed skill, a copy carrying the candidate description,
# or the skill in --skill-dir, plus any --with-skills neighbors.
build_bundle "$src" "$skill" "$ws/bundle" || exit 2
for idx in "${!with_skills[@]}"; do
  build_bundle "$repo/${with_rels[$idx]}" "${with_skills[$idx]}" "$ws/bundle" || exit 2
done
commit="$(git -C "$repo" rev-parse HEAD)" || exit 2
tree=null
if [ -n "$desc_file" ]; then
  printf '%s\n' "$candidate" > "$ws/description.txt"
  evalkit set-description "$ws/bundle/skills/$skill/SKILL.md" "$ws/description.txt" || exit 2
elif [ -z "$skill_dir" ]; then
  tree="$(skill_tree "$repo" "$commit" "$rel")"
fi
sha="$(evalkit skill-meta "$ws/bundle/skills/$skill/SKILL.md" | jq -r .description_sha256)" || exit 2
plugin="$(jq -n --arg c "$commit" --arg t "$tree" --arg s "$sha" \
  '{commit: $c, skill_tree: (if $t == "null" then null else $t end), description_sha256: $s}')"

jq -n --arg pack "$pack" --arg skill "$skill" --argjson manual "$manual" --arg harness "$harness" \
  --arg hv "$harness_version" --arg model "$model" --argjson plugin "$plugin" --argjson runs "$runs" \
  --argjson thr "$threshold" --argjson queries "$queries" --argjson with "$with_json" --arg started "$(utc_now)" \
  '{schema_version: 1, pack: $pack, skill: $skill, manual_only: ($manual == 1), harness: $harness,
    harness_version: (if $hv == "" then null else $hv end), model_flag: (if $model == "" then null else $model end),
    plugin: $plugin, runs: $runs, threshold: $thr, queries: $queries, with_skills: $with, started_at: $started}' \
  > "$ws/plan.json" || exit 2

# One activation session. Stops the session as soon as a skill loads: a
# trigger (or cross-trigger) needs no more evidence, and the rest is cost.
probe() { # $1 query index $2 run number $3 query text $4 fixture (may be empty)
  local qi="$1" k="$2" text="$3" fx="$4" rd="$ws/q$1/run-$2" base="$run_base/q$1/run-$2"
  local wd stream err pid rc=0 ran=0 chain triggered=0 valid=0 reason="" setup="" seen_chain=""
  wd="$base/work"; stream="$rd/stream.ndjson"; err="$rd/stderr.log"
  mkdir -p "$rd" && : > "$stream" && : > "$err"
  if ! seed_workdir "$wd" "${fx:+$files_dir/$fx}"; then
    reason=seed_failed
  else
    ( lab_session "$base" "$ws/bundle" activation "$wd" "$text" "$stream" "$err"; r=$?
      printf '%s' "$setup_failed" > "$rd/setup"; exit "$r" ) &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
      if command -v pgrep >/dev/null 2>&1; then
        seen_chain="$(adapter_chain "$stream" 2>/dev/null || true)"
        if printf '%s\n' "$seen_chain" | grep -qxF "$skill"; then
          stop_tree "$pid"; break
        elif [ "${#with_skills[@]}" -gt 0 ] && [ -n "$seen_chain" ]; then
          stop_tree "$pid"; break
        fi
      fi
      sleep 0.2
    done
    wait "$pid" 2>/dev/null; rc=$?
    lab_home_cleanup "$base"
    setup="$(cat "$rd/setup" 2>/dev/null)"; rm -f "$rd/setup"
  fi
  chain="$(adapter_chain "$stream" 2>/dev/null | awk 'NF && !seen[$0]++')"
  printf '%s\n' "$chain" | grep -qxF "$skill" && triggered=1
  adapter_ran "$stream" 2>/dev/null && ran=1
  if [ "$triggered" -eq 1 ] || { [ "${#with_skills[@]}" -gt 0 ] && [ -n "$chain" ]; }; then
    valid=1
  elif [ -n "$reason$setup" ]; then
    reason="${reason:-$setup}"
  elif lab_refusal "$stream" "$err"; then
    reason=refusal
  elif [ "$rc" -eq 124 ]; then
    reason=timeout
  elif [ "$ran" -ne 1 ]; then
    reason=no_model_turn
  else
    valid=1
  fi
  jq -n --argjson valid "$valid" --argjson trig "$triggered" --arg chain "$chain" --argjson rc "$rc" \
    --arg reason "$reason" --arg model "$(adapter_session_model "$stream" 2>/dev/null)" \
    '{valid: ($valid == 1), triggered: ($trig == 1), skill_chain: ($chain | split("\n") | map(select(. != ""))),
      exit_status: $rc, reason: (if $reason == "" then null else $reason end),
      model: (if $model == "" then null else $model end)}' > "$rd/result.json"
  rm -rf "$base"
}

# Sliding-window worker pool so a slow query never stalls idle slots.
done_dir="$run_base/done"
mkdir -p "$done_dir"
have_wait_n=0
if [ "${BASH_VERSINFO[0]:-0}" -gt 4 ] \
   || { [ "${BASH_VERSINFO[0]:-0}" -eq 4 ] && [ "${BASH_VERSINFO[1]:-0}" -ge 3 ]; }; then
  have_wait_n=1
fi
reap_finished() {
  local alive=() entry pid slot_id
  for entry in "${active_pids[@]+"${active_pids[@]}"}"; do
    pid="${entry%%:*}"
    slot_id="${entry#*:}"
    if [ -f "$done_dir/$slot_id" ] || ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid" 2>/dev/null || true
      rm -f "$done_dir/$slot_id"
    else
      alive+=("$pid:$slot_id")
    fi
  done
  active_pids=("${alive[@]+"${alive[@]}"}")
}
slot=0
while IFS= read -r q; do
  qi="$(jq -r .index <<< "$q")"; text="$(jq -r .query <<< "$q")"
  qfx="$(jq -r --arg d "$fixture" '.fixture // $d' <<< "$q")"
  for k in $(seq 1 "$runs"); do
    while [ "${#active_pids[@]}" -ge "$jobs" ]; do
      reap_finished
      [ "${#active_pids[@]}" -ge "$jobs" ] || break
      if [ "$have_wait_n" -eq 1 ]; then wait -n 2>/dev/null || true; else sleep 0.1; fi
      reap_finished
    done
    slot=$((slot + 1))
    _trig_done_marker="$done_dir/$slot"
    (
      trap - EXIT INT TERM
      trap ': > "$_trig_done_marker"' EXIT
      probe "$qi" "$k" "$text" "$qfx"
    ) &
    active_pids+=("$!:$slot")
  done
done < <(jq -c '.[]' <<< "$queries")
for entry in "${active_pids[@]+"${active_pids[@]}"}"; do
  wait "${entry%%:*}" 2>/dev/null || true
done
active_pids=()
rm -rf "$done_dir"

evalkit triggering "$ws" || exit 2
jq -r '.[] | "  \(.verdict | ascii_upcase | .[0:12] | . + (" " * (12 - length))) \(if .should_trigger then "+" else "-" end) rate=\(.rate // "-") (\(.triggered_runs)/\(.valid_runs))\(if ((.other_skills // {}) | length) > 0 then " other=" + ((.other_skills | to_entries | map("\(.key):\(.value)") | join(","))) else "" end)  [\(.split)] \(.query[0:68])"' \
  "$ws/query-results.json" >&2
jq -r '.splits | to_entries[] | "  \(.key): \(.value.passed)/\(.value.queries) passed, pass_rate=\(.value.pass_rate // "-"), inconclusive=\(.value.inconclusive)"' \
  "$ws/triggering.json" >&2
log "workspace: $ws"
[ -n "$desc_file$skill_dir" ] || [ "${#with_skills[@]}" -gt 0 ] || log "record it with: evals/bin/report $ws"
if [ "$print_json" -eq 1 ]; then cat "$ws/triggering.json"; else printf '%s\n' "$ws/triggering.json"; fi
jq -e 'all(.[]; .verdict == "pass")' "$ws/query-results.json" >/dev/null || exit 1
exit 0
